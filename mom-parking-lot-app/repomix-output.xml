@media (max-width: 600px) {
  .columns:not(.single-column):not(.piles-view) {
    grid-template-columns: minmax(0, 1fr);
  }

  .columns.single-column {
    grid-template-columns: minmax(0, 1fr);
  }

  .columns.piles-view {
    flex-direction: column;
    flex-wrap: nowrap;
    overflow-x: visible;
    margin-inline: 0;
    padding-inline: 0;
  }

  .columns.piles-view .column {
    flex: none;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    min-height: 0;
  }

  .overview {
    padding: 1rem;
    padding-left: max(1rem, env(safe-area-inset-left, 0px));
    padding-right: max(1rem, env(safe-area-inset-right, 0px));
    padding-bottom: max(1rem, env(safe-area-inset-bottom, 0px));
  }

  .today-header {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    gap: 0.5rem 1rem;
  }

  .today-header-main {
    grid-column: 1;
    grid-row: 1;
  }

  #completed-tally {
    grid-column: 1 / -1;
    grid-row: 2;
  }

  .today-header-actions {
    grid-column: 2;
    grid-row: 1;
    align-self: center;
  }

  .btn-hamburger {
    justify-self: end;
  }

  .today-header .btn-secondary {
    font-size: 0.8rem;
    padding: 0.35rem 0.6rem;
  }

  .today-bar-sticky.sticky-bar {
    padding: 0.75rem 1rem;
  }

  .today-panel-body {
    padding: 0 1rem 0.75rem;
  }

  .today-header h2 {
    font-size: 1rem;
  }

  .column {
    min-height: 160px;
    padding: 0.75rem;
  }

  .task-card {
    padding: 0.75rem;
    font-size: 0.9rem;
  }

  .talk-about-section {
    padding: 1rem;
    margin-top: 1.5rem;
  }

  .talk-about-add {
    flex-direction: column;
  }

  .talk-about-add .btn-primary {
    width: 100%;
  }

  .add-to-suggestions-float .btn-primary {
    font-size: 0.9rem;
    padding: 0.6rem 1rem;
  }

  .floating-buttons {
    bottom: 1rem;
    right: 1rem;
  }

  .fab {
    width: 48px;
    height: 48px;
    font-size: 1.2rem;
  }

  .fab-primary {
    font-size: 1.5rem;
  }

  .modal-content {
    margin: 0.5rem;
    max-height: 85vh;
  }

  .modal-body {
    padding: 1rem;
  }

  .analytics-panel {
    left: 1rem;
    right: 1rem;
    bottom: 5rem;
    max-width: none;
  }

  .toast {
    left: 1rem;
    right: 1rem;
    transform: translateY(100px);
    width: auto;
  }

  .toast.visible {
    transform: translateY(0);
  }
}

/* Extra small - very narrow phones */
@media (max-width: 380px) {
  .pair-setup {
    padding: 1.5rem 1rem;
  }

  .pair-code {
    font-size: 1.25rem;
