  gap: 0.75rem;
}

.join-section input[type="text"] {
  flex: 1;
  padding: 0.6rem 0.75rem;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--text);
  font-size: 1rem;
}

.join-section input[type="text"]:focus {
  outline: none;
  border-color: var(--accent-coral);
}

.join-who {
  margin: 0;
  font-size: 0.9rem;
  color: var(--text-muted);
}

.join-who-btns {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.join-who-btns label {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  cursor: pointer;
  font-size: 0.95rem;
}

.join-who-btns input[type="radio"] {
  cursor: pointer;
}

.link-partner-hint {
  color: var(--text-muted);
  font-size: 0.9rem;
  margin-bottom: 1rem;
}

.link-partner-actions {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.link-join-section {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.link-join-section input[type="text"] {
  padding: 0.6rem 0.75rem;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--text);
  font-size: 1rem;
}

.pair-created {
  margin-top: 2rem;
}

.pair-created p {
  margin-bottom: 0.5rem;
}

.pair-code {
  font-family: monospace;
  font-size: 1.5rem;
  letter-spacing: 0.2em;
  color: var(--accent-sage);
  margin: 1rem 0;
}

.pair-badge {
  font-size: 0.8rem;
  color: var(--text-muted);
  padding: 0.2rem 0.5rem;
  background: var(--bg-card);
  border-radius: 6px;
}

/* Talk about section */
.talk-about-section {
  margin-top: 2rem;
  padding: 1.5rem;
  background: var(--bg-card);
  border-radius: var(--radius);
  border: 1px solid var(--border);
}

.talk-about-header {
  margin: 0 0 1rem 0;
  font-size: 1.1rem;
  color: var(--accent-sage);
}

.talk-about-list {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  min-height: 80px;
  margin-bottom: 1rem;
}

.talk-about-item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.6rem 0.75rem;
  background: var(--bg-soft);
  border-radius: 8px;
  font-size: 0.9rem;
}

.talk-about-item .task-text {
  flex: 1;
}

.talk-about-item .added-by {
  font-size: 0.75rem;
  color: var(--text-muted);
}

.talk-about-item .btn-resolve-talk {
  padding: 0.25rem 0.5rem;
  background: var(--accent-sage);
  color: var(--bg);
  border: none;
  border-radius: 6px;
  cursor: pointer;
  font-size: 0.85rem;
}

.talk-about-item .btn-resolve-talk:hover {
  background: #6fa88a;
}

.talk-about-add {
  display: flex;
  gap: 0.5rem;
}

.talk-about-add input {
  flex: 1;
  padding: 0.6rem 0.75rem;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--text);
  font-size: 1rem;
}

.talk-about-add input:focus {
  outline: none;
  border-color: var(--accent-coral);
}

/* Email Triage */
/* Email triage dropdown - opens below the Email triage button */
.email-triage-dropdown {
  position: absolute;
  top: 100%;
  right: 0;
  margin-top: 0.5rem;
  min-width: 320px;
  max-width: min(400px, 95vw);
  max-height: 70vh;
  overflow-y: auto;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  z-index: 200;
}

.email-triage-dropdown-content {
  padding: 1rem 1.25rem;
}

.email-triage-section {
  margin-bottom: 1.5rem;
  padding: 1rem 1.5rem;
  background: var(--bg-card);
  border-radius: var(--radius);
  border: 1px solid var(--border);
}

.email-triage-header {
  margin: 0 0 0.5rem 0;
  font-size: 1.1rem;
  color: var(--accent-amber);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
}

.email-triage-header .close-email-triage-btn {
  margin-left: auto;
  padding: 0.2rem 0.4rem;
  font-size: 1.2rem;
  line-height: 1;
}

.email-triage-header-actions {
  display: flex;
  gap: 0.5rem;
  margin-bottom: 0.25rem;
}

.email-triage-status {
  margin: 0 0 0.75rem 0;
  font-size: 0.85rem;
  color: var(--text-muted);
}

.email-triage-list {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.email-triage-empty {
  margin: 0;
  font-size: 0.95rem;
  color: var(--text-muted);
}

.email-triage-card {
  padding: 0.75rem 1rem;
  background: var(--bg);
  border-radius: var(--radius);
  border: 1px solid var(--border);
}

.email-triage-card-main strong {
  display: block;
  font-size: 0.95rem;
  margin-bottom: 0.25rem;
}

.email-triage-task-input {
  display: block;
  width: 100%;
  margin: 0 0 0.5rem 0;
  padding: 0.4rem 0.5rem;
  font-size: 0.9rem;
  color: var(--text);
  background: var(--bg-soft);
  border: 1px solid var(--border);
  border-radius: 6px;
  box-sizing: border-box;
}

.email-triage-draft {
  margin: 0.5rem 0;
  font-size: 0.8rem;
}

.email-triage-draft pre {
  margin: 0.25rem 0 0 0;
  white-space: pre-wrap;
  word-break: break-word;
}

.email-triage-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem;
  margin-top: 0.5rem;
}

.email-triage-actions select {
  padding: 0.35rem 0.5rem;
  background: var(--bg-soft);
  border: 1px solid var(--border);
  border-radius: 6px;
  color: var(--text);
  font-size: 0.85rem;
}

.btn-sm {
  padding: 0.35rem 0.6rem;
  font-size: 0.85rem;
}

.email-triage-link {
  font-size: 0.85rem;
  color: var(--accent-sage);
  text-decoration: none;
}

.email-triage-link:hover {
  text-decoration: underline;
}

/* Today: only the header + week strip stick; task list scrolls with the page (no overlay on columns). */
.today-panel-wrap {
  background: var(--bg-soft);
  border-bottom: 1px solid var(--border);
}

.today-bar-sticky.sticky-bar {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--bg-soft);
  border-top: 4px solid var(--header-accent, var(--accent-coral));
  border-bottom: 1px solid var(--border);
  padding: 1rem 1.5rem;
}

.today-panel-body {
  padding: 0 1.5rem 1rem;
  background: var(--bg-soft);
}

.focus-banner .plan-focus-btn {
  margin-right: 0.35rem;
}

.focus-banner-hint {
  color: var(--text-muted);
  font-size: 0.9rem;
  margin: 0 0.25rem;
}

.today-header {
  display: grid;
  grid-template-columns: auto auto 1fr auto;
  gap: 1rem;
  align-items: center;
}

.today-header-main {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  grid-column: 1;
}

#completed-tally {
  grid-column: 2;
}

.today-header-actions {
  grid-column: 4;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0.5rem;
  position: relative;
}

.btn-hamburger {
  justify-self: end;
}

.today-header h2 {
  margin: 0;
  font-size: 1.1rem;
  font-weight: 600;
}

.btn-hamburger {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 4px;
  width: 40px;
  height: 40px;
  padding: 0;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  cursor: pointer;
}

.btn-hamburger:hover {
  background: var(--bg-soft);
  border-color: var(--text-muted);
}

.hamburger-line {
  display: block;
  width: 18px;
  height: 2px;
  background: var(--text);
  border-radius: 1px;
}

/* Sidebar */
.sidebar-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
  opacity: 0;
  transition: opacity 0.2s ease;
  /* Avoid invisible hit-target if display:block ever desyncs from body.sidebar-open */
  pointer-events: none;
}

body.sidebar-open .sidebar-overlay {
  opacity: 1;
  pointer-events: auto;
}

.sidebar {
  position: fixed;
  top: 0;
  right: 0;
  width: 280px;
  max-width: 85vw;
  height: 100vh;
  background: var(--bg-soft);
  border-left: 1px solid var(--border);
  z-index: 101;
  transform: translateX(100%);
  transition: transform 0.25s ease;
  display: flex;
  flex-direction: column;
  box-shadow: -4px 0 20px rgba(0, 0, 0, 0.3);
}

.sidebar.open {
  transform: translateX(0);
}

.sidebar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.25rem 1rem;
  border-bottom: 1px solid var(--border);
}

.sidebar-header .pair-badge {
  font-size: 0.9rem;
  flex: 1;
  min-width: 0;
}

.sidebar-header .btn-close {
  flex-shrink: 0;
  margin-left: 0.5rem;
}

.sidebar-nav {
  display: flex;
  flex-direction: column;
  padding: 0.5rem;
}

.sidebar-item {
  display: block;
  width: 100%;
  padding: 0.65rem 1rem;
  background: none;
  border: none;
  border-radius: 8px;
  color: var(--text);
  font-size: 0.95rem;
  text-align: left;
  cursor: pointer;
}

.sidebar-item:hover {
  background: var(--bg-card);
}

.tally {
  color: var(--accent-sage);
  font-size: 0.9rem;
}

.today-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: 0.75rem;
  min-height: 2.5rem;
  transition: background 0.15s, border-color 0.15s;
}

.today-list.drag-over {
  background: rgba(129, 178, 154, 0.15);
  border-radius: var(--radius);
  border: 2px dashed var(--accent-sage);
}

.unified-today {
  flex-direction: column;
  flex-wrap: nowrap;
  align-items: stretch;
}

.today-header-main {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem;
}

.week-strip-toggle-label {
  font-size: 0.85rem;
  color: var(--text-muted);
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
}

.week-strip-row {
  flex-wrap: wrap;
  gap: 0.35rem;
  margin-top: 0.5rem;
  align-items: center;
}

.week-strip-chip {
  border: 1px solid var(--border);
  background: var(--bg-card);
  border-radius: 999px;
  padding: 0.25rem 0.5rem;
  font-size: 0.8rem;
  cursor: pointer;
  color: var(--text);
}

.week-strip-chip.week-strip-today {
  border-color: var(--accent);
  box-shadow: 0 0 0 1px var(--accent);
}

.week-plan-fullscreen {
  position: fixed;
  inset: 0;
  z-index: 4000;
  background: var(--bg);
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  overflow: hidden;
}

.week-plan-fullscreen-inner {
  display: flex;
  flex-direction: column;
  height: 100%;
  max-width: min(1200px, 100%);
  margin: 0 auto;
  padding: 1rem;
  box-sizing: border-box;
}

/* Week planner: header + toolbar stay put; calendar and piles each scroll inside their pane */
.week-plan-fullscreen-inner.week-planning-layout {
  overflow: hidden;
  min-height: 0;
  padding: 0.45rem 0.65rem 0.65rem;
}

.week-planning-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 0.75rem;
  flex-shrink: 0;
  margin-bottom: 0.35rem;
}

.week-planning-header-text {
  display: flex;
  flex-direction: column;
  gap: 0.05rem;
  min-width: 0;
}

.week-planning-header h2 {
  margin: 0;
  font-size: 1.1rem;
  line-height: 1.25;
  font-weight: 700;
}

.week-planning-header-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  gap: 0.35rem;
  flex-shrink: 0;
}

.week-planning-sub {
  margin: 0;
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--text-muted);
  line-height: 1.2;
}

.week-planning-layout .week-planning-last-week {
  margin-bottom: 0.35rem;
  padding: 0.35rem 0.5rem;
}

.week-planning-calendar-wrap {
  flex-shrink: 0;
  margin: 0 0 0.5rem;
  max-height: min(58vh, 32rem);
  overflow-x: auto;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  min-height: 8rem;
}

.week-planning-calendar-row {
  display: flex;
  flex-direction: row;
  gap: 0.5rem;
  align-items: stretch;
  overflow-x: auto;
  padding-bottom: 0.35rem;
  scroll-snap-type: x proximity;
}

.week-planning-piles-ref {
  flex: 1 1 0;
  min-height: 0;
  margin-top: 0;
  padding: 1rem;
  border-radius: var(--radius);
  border: 1px solid var(--border);
  background: var(--bg-soft);
  overflow-x: auto;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.week-planning-piles-ref .columns.piles-view.week-plan-ref-board {
  margin-bottom: 0;
}

.week-planning-ref-title {
  margin: 0 0 0.75rem;
  font-size: 1rem;
  font-weight: 600;
  color: var(--text);
}

.plan-ref-empty {
  margin: 0;
  font-size: 0.9rem;
  color: var(--text-muted);
}

/* Read-only mirror of main board: hide actions (reference only while planning) */
.week-plan-ref-board .task-actions,
.week-plan-ref-board .task-drag-handle {
  display: none !important;
}

.week-plan-ref-board .task-card {
  cursor: default;
}

.week-plan-ref-board .task-meta-clickable {
  pointer-events: none;
}

.plan-day-card {
  flex: 1 1 0;
  min-width: 10rem;
  max-width: 11.5rem;
  scroll-snap-align: start;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 0.5rem 0.45rem;
  background: var(--bg-card);
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
  min-height: 0;
}

.plan-day-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.1rem;
  text-align: center;
  padding-bottom: 0.35rem;
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}

.plan-day-weekday {
  font-size: 0.7rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  color: var(--text-muted);
}

.plan-day-numline {
  font-size: 1rem;
  font-weight: 700;
  color: var(--text);
}

.plan-day-card.plan-day-today {
  border-color: var(--accent);
  box-shadow: 0 0 0 1px var(--accent);
}

.plan-pile-picker {
  flex-shrink: 0;
  width: 100%;
}

.plan-pile-picker-label {
  font-size: 0.65rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--text-muted);
  text-align: center;
  margin-bottom: 0.3rem;
}

.plan-pile-no-piles-msg {
  font-size: 0.65rem;
  margin: 0 0 0.5rem;
  color: var(--text-muted);
  text-align: center;
}

.plan-pile-quick-row {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  gap: 0.2rem;
  align-items: stretch;
  justify-content: space-between;
}

.plan-pile-quick {
  flex: 1 1 0;
  min-width: 0;
  min-height: 2.5rem;
  padding: 0.25rem 0.2rem;
  font-size: 0.72rem;
  line-height: 1.15;
  border-radius: 6px;
  border: 1px solid var(--border);
  background: var(--bg-soft);
  color: var(--text);
  cursor: pointer;
  text-align: center;
  word-break: break-word;
}

.plan-pile-slot-empty {
  flex: 1 1 0;
  min-width: 0;
  min-height: 2.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.85rem;
  color: var(--text-muted);
  border: 1px dashed var(--border);
  border-radius: 6px;
  opacity: 0.65;
}

.plan-pile-quick:hover {
  border-color: var(--accent);
  background: var(--bg-card);
}

.plan-pile-quick.is-selected {
  border-color: var(--accent-button, var(--accent-coral));
  background: rgba(224, 122, 95, 0.15);
  font-weight: 600;
}

.plan-pile-more {
  font-size: 0.7rem;
  margin-top: 0.15rem;
}

.plan-pile-more summary {
  cursor: pointer;
  color: var(--accent);
  list-style: none;
}

.plan-pile-more summary::-webkit-details-marker {
  display: none;
}

.plan-pile-more-list {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
  margin-top: 0.35rem;
}

.plan-pile-quick-more {
  font-size: 0.65rem;
}

.plan-pile-clear {
  display: block;
  width: 100%;
  margin-top: 0.35rem;
  padding: 0;
  border: none;
  background: none;
  font-size: 0.65rem;
  color: var(--text-muted);
  cursor: pointer;
  text-decoration: underline;
  text-underline-offset: 2px;
  text-align: center;
}

.plan-pile-clear:hover {
  color: var(--text);
}

.plan-day-list {
  flex: 1 1 auto;
  min-height: 2rem;
  max-height: 10rem;
  overflow-y: auto;
  margin-top: 0.15rem;
  min-width: 0;
}

.plan-day-task {
  display: flex;
  align-items: flex-start;
  gap: 0.2rem;
  padding: 0.2rem 0;
  border-bottom: 1px solid var(--border);
  font-size: 0.72rem;
}

.plan-task-text {
  flex: 1;
}

.plan-day-task .btn-sm {
  padding: 0.08rem 0.2rem;
  font-size: 0.65rem;
  flex-shrink: 0;
}

.week-planning-last-week {
  margin-bottom: 0.75rem;
  padding: 0.5rem;
  background: var(--bg-soft);
  border-radius: var(--radius);
}

.last-week-inner {
  font-size: 0.85rem;
  color: var(--text-muted);
  margin-top: 0.35rem;
}

.plan-review-four-blocks {
  display: grid;
  gap: 1rem;
  margin: 1rem 0;
}

@media (min-width: 640px) {
  .plan-review-four-blocks {
    grid-template-columns: 1fr 1fr;
  }
}

.review-block {
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 0.75rem;
  background: var(--bg-card);
}

.review-ul {
  margin: 0.35rem 0 0;
  padding-left: 1.1rem;
  font-size: 0.9rem;
}

.review-my-week-wrap {
  margin-top: 1rem;
  padding-top: 0.75rem;
  border-top: 1px solid var(--border);
  position: relative;
}

.review-my-week-dropdown {
  margin-top: 0.5rem;
  padding: 0.75rem;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
}

.unified-today-details summary {
  cursor: pointer;
  font-weight: 600;
  padding: 0.35rem 0;
}

.unified-today-focus-hint,
.focus-pile-hint {
  margin: 0.15rem 0 0.5rem;
  padding: 0 0.1rem;
  font-size: 0.85rem;
  color: var(--text-muted);
  line-height: 1.4;
}

.badge-count {
  display: inline-block;
  margin-left: 0.35rem;
  padding: 0.1rem 0.4rem;
  border-radius: 999px;
  background: var(--bg-soft);
  font-size: 0.8rem;
}

.btn-link {
  background: none;
  border: none;
  color: var(--accent);
  cursor: pointer;
  text-decoration: underline;
  text-underline-offset: 2px;
  font: inherit;
  padding: 0;
}

.btn-danger {
  background: #b94a48;
  color: #fff;
  border: none;
  border-radius: 6px;
  padding: 0.35rem 0.65rem;
  cursor: pointer;
  font-size: 0.85rem;
}

.week-view-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  padding: 0.5rem 0;
  border-bottom: 1px solid var(--border);
}

.week-view-meta {
  font-size: 0.9rem;
  color: var(--text-muted);
}

.modal-content-narrow {
  max-width: 420px;
}

body.week-planning-open {
  overflow: hidden;
}

.today-item-accent {
  border-left: 4px solid var(--today-accent, var(--border));
}

.today-item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 0.75rem;
  background: var(--bg-card);
  border-radius: var(--radius);
  font-size: 0.9rem;
}

.today-item .task-text {
  flex: 1;
}

.today-item .btn-done, .today-item .btn-remove {
  padding: 0.25rem 0.5rem;
  font-size: 0.8rem;
  border: none;
  border-radius: 6px;
  cursor: pointer;
  background: transparent;
  color: var(--text-muted);
}

.today-item .btn-done:hover {
  background: var(--accent-sage);
  color: var(--bg);
}

.today-item .btn-remove:hover {
  background: var(--bg-soft);
  color: var(--text);
}

/* Overview - 4 columns */
.overview {
  padding: 1.5rem;
  max-width: 100%;
  box-sizing: border-box;
}

.columns-header {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-bottom: 1rem;
}

.view-toggle {
  display: flex;
  border: 1px solid var(--border);
  border-radius: 6px;
  overflow: hidden;
}
.view-toggle-btn {
  padding: 0.4rem 0.75rem;
  font-size: 0.9rem;
  background: transparent;
  border: none;
  color: var(--text-muted);
  cursor: pointer;
}
.view-toggle-btn.active {
  background: var(--accent-button, var(--accent-coral));
  color: var(--bg);
}
.view-toggle-btn:not(.active):hover {
  background: var(--bg-secondary);
}

.search-input {
  flex: 1;
  max-width: 280px;
  padding: 0.65rem 1rem;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--text);
  font-size: 1rem;
  transition: border-color 0.2s;
}

.search-input::placeholder {
  color: var(--text-muted);
}

.search-input:focus {
  outline: none;
  border-color: var(--accent-coral);
}

.btn-back {
  background: var(--bg-card);
  border: 1px solid var(--border);
  color: var(--text);
  padding: 0.5rem 1rem;
  border-radius: var(--radius);
  cursor: pointer;
  font-size: 0.9rem;
}

.btn-back:hover {
  background: var(--bg-soft);
}

/* Category columns: 4 equal lanes on large screens; 2×2 on tablet; stack on small phones */
.columns {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 1rem;
  margin-bottom: 1.5rem;
  max-width: 100%;
  box-sizing: border-box;
}

.columns.single-column {
  grid-template-columns: minmax(0, 1fr);
}

/* Piles: share width when they fit; extra piles stay readable (min width) and scroll horizontally */
.columns.piles-view {
  display: flex;
  flex-flow: row nowrap;
  align-items: stretch;
  gap: 1rem;
  overflow-x: auto;
  overflow-y: visible;
  padding: 0.125rem 0.125rem 0.35rem;
  margin-inline: -0.125rem;
  -webkit-overflow-scrolling: touch;
  overscroll-behavior-x: contain;
  scrollbar-gutter: stable;
  max-width: 100%;
  box-sizing: border-box;
}

/* flex-grow shares spare space equally; flex-shrink: 0 + basis keeps a floor when there are many piles */
.columns.piles-view .column {
  flex: 1 0 11.25rem;
  min-width: 0;
}

@media (min-width: 601px) {
  .columns.piles-view .column {
    flex: 1 0 12rem;
  }
}

/* Tablet: category board 2×2 so lanes stay readable */
@media (max-width: 1024px) and (min-width: 601px) {
  .columns:not(.single-column):not(.piles-view) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

.column {
  background: var(--bg-card);
  border-radius: var(--radius);
  padding: 1rem;
  min-height: 200px;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.column-accent {
  border-left: 4px solid var(--column-accent, var(--border));
}

.column-add-btn {
  display: block;
  width: 100%;
  margin-top: 0.5rem;
  padding: 0.4rem 0.75rem;
  background: var(--bg-soft);
  border: 1px dashed var(--border);
  border-radius: 8px;
  color: var(--text-muted);
  font-size: 0.85rem;
  cursor: pointer;
}

.column-add-btn:hover {
  background: var(--bg-card);
  color: var(--text);
  border-color: var(--text-muted);
}

.column-header {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.25rem;
  font-weight: 600;
  font-size: 0.95rem;
  margin-bottom: 0.75rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid var(--border);
  cursor: pointer;
  color: var(--text);
}

.column-header:hover {
  color: var(--accent-coral);
}

.column-header .count {
  color: var(--text-muted);
  font-weight: 400;
  font-size: 0.85rem;
}

.column-header-draggable {
  cursor: grab;
}

.column-header-draggable:active {
  cursor: grabbing;
}

.column-dragging {
  opacity: 0.7;
}

.column-note-btn {
  margin-left: auto;
  padding: 0.2rem 0.4rem;
  font-size: 0.9rem;
  background: transparent;
  border: none;
  cursor: pointer;
  opacity: 0.8;
  border-radius: 4px;
}
.column-note-btn:hover {
  opacity: 1;
  background: var(--bg-secondary);
}
.column-note-panel {
  margin-bottom: 0.5rem;
}

.column-note-full {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-bottom: 0;
}
.column-note-textarea {
  width: 100%;
  min-height: 4rem;
  padding: 0.5rem;
  font-size: 0.9rem;
  background: var(--bg);
  color: var(--text);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  resize: vertical;
  box-sizing: border-box;
}

.column-note-full .column-note-textarea {
  flex: 1;
  min-height: 12rem;
}
.column-note-textarea::placeholder {
  color: var(--text-muted);
}
.column-note-textarea-wrap {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

.column-note-turn-popover {
  flex-shrink: 0;
}

.column-note-turn-popover .column-turn-into-task {
  margin: 0;
}

.column-note-btn-close {
  font-size: 1.25rem;
  font-weight: 300;
  line-height: 1;
}

.column-items {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  min-width: 0;
  min-height: 0;
}

.task-card {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
  padding: 0.6rem 0.75rem;
  background: var(--bg-soft);
  border-radius: 8px;
  font-size: 0.9rem;
  border-left: 3px solid transparent;
}

.task-card.selected {
  border-left-color: var(--header-accent, var(--accent-button, var(--accent-coral)));
  background: color-mix(in srgb, var(--header-accent, var(--accent-button, #e07a5f)) 12%, transparent);
}

.task-card.overdue {
  border-left-color: var(--accent-amber);
}

.task-card.dragging {
  opacity: 0.6;
}

.task-drag-handle {
  cursor: grab;
  padding: 0.25rem;
  margin: -0.25rem 0 -0.25rem -0.25rem;
  color: var(--text-muted);
  font-size: 0.9rem;
  line-height: 1;
  flex-shrink: 0;
  user-select: none;
}

.task-drag-handle:active {
  cursor: grabbing;
}

.task-drag-handle:hover {
  color: var(--text);
}

.task-card input[type="checkbox"] {
  margin-top: 0.2rem;
  cursor: pointer;
}

.task-content {
  flex: 1;
  min-width: 0;
}

.task-text {
  overflow-wrap: break-word;
  word-break: normal;
}

.task-meta {
  display: flex;
  gap: 0.5rem;
  margin-top: 0.25rem;
  font-size: 0.75rem;
  color: var(--text-muted);
}

.task-meta .overdue-badge {
  color: var(--accent-amber);
}

.task-meta .recurrence-badge {
  color: var(--accent-sage);
  font-size: 0.9em;
}

.task-meta-clickable {
  cursor: pointer;
}
.task-meta-clickable:hover {
  color: var(--text);
}
.task-meta .priority-badge,
.task-meta .doing-badge,
.task-meta .pile-tag,
.task-meta .friction-badge {
  font-size: 0.7rem;
  opacity: 0.9;
}
.task-meta .pile-tag,
.task-meta .life-area-tag {
  background: var(--bg-secondary, #2d2d2d);
  padding: 0.1rem 0.35rem;
  border-radius: 4px;
}
.task-meta .friction-badge {
  text-transform: capitalize;
}
.task-first-step {
  font-size: 0.8rem;
  opacity: 0.9;
  margin-top: 0.25rem;
  color: var(--text-muted);
}
.settings-piles-list {
  margin-bottom: 0.75rem;
}
.settings-pile-row {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 0.5rem;
  flex-wrap: wrap;
}
.settings-pile-row .settings-pile-name {
  font-weight: 500;
  min-width: 6rem;
}
.settings-pile-row .settings-pile-meta {
  font-size: 0.85rem;
  opacity: 0.8;
}
.settings-piles-add {
  display: flex;
  gap: 0.5rem;
  align-items: center;
  margin-bottom: 1rem;
}
.settings-piles-add .settings-name-input {
  flex: 1;
  max-width: 14rem;
}
.task-meta-edit {
  display: flex;
  flex-wrap: wrap;
  gap: 0.35rem;
  align-items: center;
  margin-top: 0.25rem;
}

.task-meta-edit .meta-date-group {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
}

.task-meta-edit .meta-date-label {
  font-size: 0.7rem;
  color: var(--text-muted);
  white-space: nowrap;
}
.task-meta-edit select.meta-priority {
  font-size: 0.75rem;
  padding: 0.15rem 0.25rem;
  border-radius: 4px;
  border: 1px solid var(--border);
  background: var(--bg-soft);
  color: var(--text);
}
.task-meta-edit input[type="date"] {
  font-size: 0.75rem;
  padding: 0.15rem 0.25rem;
  border-radius: 4px;
  border: 1px solid var(--border);
  background: var(--bg-soft);
  color: var(--text);
}
.task-meta-edit .btn-meta-done {
  padding: 0.15rem 0.35rem;
  font-size: 0.85rem;
}

.add-from-talk-preview {
  margin-bottom: 0.75rem;
  padding: 0.5rem;
  background: var(--bg-soft);
  border-radius: 6px;
  font-size: 0.9rem;
  color: var(--text);
  border: 1px solid var(--border);
  width: 100%;
  box-sizing: border-box;
}

.task-actions {
  display: flex;
  gap: 0.25rem;
}

.task-actions button {
  padding: 0.2rem;
  background: none;
  border: none;
  color: var(--text-muted);
  cursor: pointer;
  font-size: 0.9rem;
}

.task-actions button:hover {
  color: var(--accent-coral);
}

.task-actions .btn-done-card {
  color: var(--accent-sage);
}
.task-actions .btn-done-card:hover {
  color: var(--accent-sage);
  opacity: 1;
}

.add-to-suggestions-float {
  position: fixed;
  bottom: 5.5rem;
  left: 50%;
  transform: translateX(-50%);
  z-index: 50;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s, transform 0.2s;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.add-to-suggestions-float.visible {
  opacity: 1;
  pointer-events: auto;
}

.add-to-suggestions-float .btn-primary {
  padding: 0.5rem 1rem;
  font-size: 0.9rem;
  box-shadow: var(--shadow);
  white-space: nowrap;
}

.btn-primary {
  background: var(--accent-button, var(--accent-coral));
  color: white;
  border: none;
  padding: 0.6rem 1.2rem;
  border-radius: var(--radius);
  cursor: pointer;
  font-size: 0.95rem;
}

.btn-primary:hover:not(:disabled) {
  background: #d4694f;
}

.btn-primary:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.btn-secondary {
  background: var(--bg-card);
  color: var(--text);
  border: 1px solid var(--border);
  padding: 0.4rem 0.8rem;
  border-radius: var(--radius);
  cursor: pointer;
  font-size: 0.85rem;
}

.btn-secondary:hover {
  background: var(--bg-soft);
}

/* Focus Mode */
.focus-mode {
  padding: 2rem;
  min-height: 60vh;
}

.focus-content h1 {
  font-size: 1.5rem;
  margin-bottom: 0.5rem;
}

.focus-tally {
  color: var(--accent-sage);
  margin-bottom: 1.5rem;
}

.focus-list {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.focus-list .task-card {
  padding: 1rem;
}

/* Floating buttons */
.floating-buttons {
  position: fixed;
  bottom: 1.5rem;
  right: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  z-index: 100;
}

.fab-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.fab-hover-help {
  position: absolute;
  right: calc(100% + 0.75rem);
  bottom: 50%;
  transform: translateY(50%);
  /* Wider for reading; cap so tooltip stays on screen (left margin + FABs on right) */
  width: max-content;
  max-width: min(320px, calc(100vw - 7rem));
  min-width: 200px;
  padding: 0.6rem 0.85rem;
  font-size: 0.95rem;
  line-height: 1.4;
  color: var(--text);
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  pointer-events: none;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.2s ease, visibility 0.2s ease;
  z-index: 101;
  white-space: normal;
  box-sizing: border-box;
}

.fab-wrap.fab-help-visible .fab-hover-help {
  opacity: 1;
  visibility: visible;
}

.fab {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  border: none;
  background: var(--bg-card);
  color: var(--text);
  font-size: 1.5rem;
  cursor: pointer;
  box-shadow: var(--shadow);
}

.fab:hover {
  background: var(--bg-soft);
}

.fab-primary {
  background: var(--accent-button, var(--accent-coral));
  color: white;
  font-size: 1.8rem;
  line-height: 1;
}

.fab-primary:hover {
  filter: brightness(0.9);
}

/* Modal */
.modal {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
  padding: 1rem;
}

.modal-content {
  background: var(--bg-card);
  border-radius: var(--radius);
  max-width: 480px;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem 1.25rem;
  border-bottom: 1px solid var(--border);
}

.modal-header h3 {
  margin: 0;
  font-size: 1.1rem;
}

.btn-close {
  background: none;
  border: none;
  color: var(--text-muted);
  font-size: 1.5rem;
  cursor: pointer;
  padding: 0;
  line-height: 1;
}

.btn-close:hover {
  color: var(--text);
}

/* Shortcuts overlay */
.shortcuts-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 300;
  padding: 1rem;
}

.shortcuts-content {
  background: var(--bg-card);
  border-radius: var(--radius);
  padding: 1.5rem;
  max-width: 320px;
}

.shortcuts-content h3 {
  margin: 0 0 1rem;
  font-size: 1.1rem;
}

.shortcuts-list {
  margin: 0 0 1rem;
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 0.5rem 1.5rem;
}

.shortcuts-list dt {
  font-weight: 600;
  color: var(--accent-coral);
}

.shortcuts-list dd {
  margin: 0;
}

.modal-body {
  padding: 1.25rem;
}

.add-mode-tabs {
  display: flex;
  gap: 0.5rem;
  margin-bottom: 1rem;
}

.tab {
  padding: 0.5rem 1rem;
  background: var(--bg-soft);
  border: none;
  border-radius: 8px;
  color: var(--text-muted);
  cursor: pointer;
  font-size: 0.9rem;
}

.tab.active {
  background: var(--accent-coral);
  color: white;
}

.voice-hint {
  font-size: 0.9rem;
  color: var(--text-muted);
  margin-bottom: 1rem;
}

.btn-voice {
  margin-bottom: 1rem;
}

.voice-transcript {
  min-height: 80px;
  padding: 0.75rem;
  background: var(--bg);
  border-radius: 8px;
  margin-bottom: 1rem;
  font-size: 0.9rem;
  color: var(--text-muted);
}

#quick-input {
  width: 100%;
  padding: 0.6rem 0.75rem;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--text);
  font-size: 1rem;
  font-family: inherit;
  margin-bottom: 1rem;
  resize: vertical;
}

#quick-input:focus {
  outline: none;
  border-color: var(--accent-coral);
}

.input-row {
  display: flex;
  gap: 0.5rem;
  margin-bottom: 1rem;
}

.input-row input {
  flex: 1;
  padding: 0.6rem 0.75rem;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--text);
  font-size: 1rem;
}

.input-row input:focus {
  outline: none;
  border-color: var(--accent-coral);
}

.btn-icon {
  padding: 0.6rem;
  background: var(--bg-soft);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  cursor: pointer;
  font-size: 1rem;
}

.btn-icon:hover {
  background: var(--bg-card);
}

.add-options {
  display: grid;
  gap: 0.5rem;
  margin-bottom: 1rem;
}

.add-options label {
  font-size: 0.85rem;
  color: var(--text-muted);
}

.hint-link {
  cursor: help;
  color: var(--accent-coral);
  margin-left: 0.25rem;
}

.add-options select,
.add-options input[type="date"],
.add-options input[type="text"] {
  padding: 0.5rem;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 8px;
  color: var(--text);
}

/* Edit modal — match add form styling */
.edit-form {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.edit-input-row {
  margin-bottom: 1rem;
}

.edit-input-row input {
  width: 100%;
  padding: 0.6rem 0.75rem;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--text);
  font-size: 1rem;
  box-sizing: border-box;
}

.edit-input-row input:focus {
  outline: none;
  border-color: var(--accent-coral);
}

.edit-options {
  display: grid;
  gap: 0.5rem;
  margin-bottom: 1rem;
}

.edit-options label {
  font-size: 0.85rem;
  color: var(--text-muted);
}

.edit-options select,
.edit-options input[type="date"],
.edit-options input[type="datetime-local"],
.edit-options input[type="text"] {
  padding: 0.5rem 0.75rem;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--text);
  font-size: 1rem;
}

.edit-options select:focus,
.edit-options input[type="date"]:focus,
.edit-options input[type="datetime-local"]:focus,
.edit-options input[type="text"]:focus {
  outline: none;
  border-color: var(--accent-coral);
}

.edit-form .btn-primary {
  margin-top: 0.25rem;
}

/* Toast */
.offline-banner {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  padding: 0.5rem 1rem;
  background: var(--accent-amber);
  color: var(--bg);
  text-align: center;
  font-size: 0.9rem;
}

.toast {
  position: fixed;
  bottom: 6rem;
  left: 50%;
  transform: translateX(-50%) translateY(100px);
  padding: 0.75rem 1.25rem;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  z-index: 9999;
  opacity: 0;
  transition: transform 0.3s, opacity 0.3s;
}

.toast.visible {
  transform: translateX(-50%) translateY(0);
  opacity: 1;
}

.toast .undo-btn {
  margin-left: 0.5rem;
  color: var(--accent-coral);
  cursor: pointer;
  text-decoration: underline;
}

.suggest-next-strip {
  display: none;
  margin-top: 0.5rem;
}
.suggest-next-strip.visible {
  display: block;
}
.suggest-next-strip .suggest-next-content {
  padding: 0.75rem 1rem;
  background: var(--bg-secondary);
  border: 1px solid var(--border);
  border-radius: var(--radius);
}
.suggest-next-strip .suggest-next-label {
  margin: 0 0 0.5rem 0;
  font-size: 0.95rem;
}
.suggest-next-strip .suggest-next-first-step {
  margin: 0 0 0.5rem 0;
  font-size: 0.85rem;
  opacity: 0.9;
}
.suggest-next-strip .suggest-next-actions {
