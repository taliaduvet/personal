# Client (Vite)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Local only — must match Google redirect URI. Omit on Vercel (app uses live URL automatically).
VITE_APP_URL=http://localhost:5173

# Server (Vercel + local — never prefix with VITE_)
GOOGLE_CLIENT_SECRET=your-client-secret

# Transcription (optional locally; required on Vercel for Transcribe button)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Vercel project env vars ---
# VITE_GOOGLE_CLIENT_ID=same-as-local
# GOOGLE_CLIENT_SECRET=same-as-local
# Do NOT set VITE_APP_URL on Vercel unless you use a custom domain.
