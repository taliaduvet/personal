# Copy to ai-worker.env (never commit ai-worker.env)

# Same as config.js
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Settings → sync code in the Parking Lot app
DEVICE_SYNC_ID=your8charsyncid

# Optional — if omitted, worker uses Gemini built-in Google Search instead
# BRAVE_API_KEY=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model (default gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Optional safety caps
MAX_JOBS_PER_RUN=3
MAX_JOBS_PER_DAY=15
