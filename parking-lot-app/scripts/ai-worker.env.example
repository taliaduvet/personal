# Copy to ai-worker.env (never commit ai-worker.env)

# Same as config.js
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Settings → sync code in the Parking Lot app
DEVICE_SYNC_ID=your8charsyncid

# https://api.search.brave.com/app/keys (free tier)
BRAVE_API_KEY=

# https://aistudio.google.com/apikey (Gemini Flash — free tier)
GEMINI_API_KEY=

# Optional safety caps
MAX_JOBS_PER_RUN=3
MAX_JOBS_PER_DAY=15
