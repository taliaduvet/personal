            </div>
            <div id="gf-new-product-inline" class="gf-new-product-inline form-row" style="display:none">
              <label>New product</label>
              <div class="gf-new-product-fields">
                <input type="text" id="gf-prod-name" placeholder="Product name" title="Product name">
                <span class="gf-size-label">Regular $</span>
                <input type="number" id="gf-prod-baseline" step="0.01" min="0" placeholder="0.00" title="Regular price per unit">
                <span class="gf-size-label">Size</span>
                <input type="number" id="gf-prod-size-value" min="0" step="any" placeholder="—" title="Regular size per unit">
                <select id="gf-prod-size-unit" title="Unit"><option value="">—</option><option value="g">g</option><option value="kg">kg</option><option value="oz">oz</option><option value="lb">lb</option><option value="ml">mL</option><option value="l">L</option></select>
                <button type="button" id="gf-prod-bc-avg-btn" class="btn btn-secondary">Use BC average</button>
                <button type="button" id="gf-prod-add-use-btn" class="btn btn-primary">Add & use below</button>
                <button type="button" id="gf-prod-cancel-btn" class="btn btn-secondary">Cancel</button>
              </div>
              <span id="gf-prod-bc-hint" class="hint"></span>
            </div>
            <div class="form-row"><label>Quantity</label><input type="number" id="gf-quantity" min="0.01" step="0.01" placeholder="1"></div>
            <div class="form-row">
              <label>GF total paid ($)</label>
              <div>
                <input type="number" id="gf-total-paid" step="0.01" min="0" placeholder="0.00">
                <label class="gf-per-unit-check"><input type="checkbox" id="gf-total-is-per-unit"> Per unit (we’ll multiply by quantity)</label>
              </div>
            </div>
            <div class="form-row"><label>Regular price per unit ($)</label><div><input type="number" id="gf-regular-unit" step="0.01" min="0" placeholder="0.00"> <span id="gf-bc-avg-hint" class="hint"></span></div></div>
            <div class="form-row gf-size-row">
              <label>Product size (optional)</label>
              <div class="gf-size-fields">
                <span class="gf-size-label">GF size per unit</span>
                <input type="number" id="gf-size-value" min="0" step="any" placeholder="e.g. 907">
                <select id="gf-size-unit"><option value="">—</option><option value="g">g</option><option value="kg">kg</option><option value="oz">oz</option><option value="lb">lb</option><option value="ml">mL</option><option value="l">L</option></select>
                <span class="gf-size-label">Regular size per unit</span>
                <input type="number" id="gf-regular-size-value" min="0" step="any" placeholder="e.g. 1">
                <select id="gf-regular-size-unit"><option value="">—</option><option value="g">g</option><option value="kg">kg</option><option value="oz">oz</option><option value="lb">lb</option><option value="ml">mL</option><option value="l">L</option></select>
              </div>
              <span class="hint">Use when package sizes differ. Match units (both weight or both volume), e.g. 907 g vs 1 kg, or 355 mL vs 473 mL.</span>
            </div>
            <div class="form-row gf-calc">
              <label>Calculated</label>
              <div id="gf-calc-fields"><span id="gf-unit-price-out">—</span>; Incremental per unit: <span id="gf-inc-unit-out">—</span>; <strong>Incremental total: <span id="gf-inc-total-out">—</span></strong></div>
              <span id="gf-size-mismatch-hint" class="hint gf-size-mismatch" style="display:none;"></span>
            </div>
            <div class="form-actions">
              <button type="button" id="gf-save-line-btn" class="btn btn-primary">Save line</button>
              <button type="button" id="gf-cancel-edit-btn" class="btn btn-secondary" style="display:none">Cancel</button>
            </div>
          </div>
          <div class="gf-list-section">
            <h3>Recent GF lines</h3>
            <div id="gf-purchases-list" class="entry-list"></div>
          </div>
        </div>
        <div class="gf-receipts-list-section">
          <h3>Your uploaded receipts</h3>
          <p class="hint">Keep these for CRA review. Click View to open the file.</p>
          <div id="gf-receipts-list" class="entry-list"></div>
