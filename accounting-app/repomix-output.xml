        <div class="gf-summary-section">
          <h3>CRA Summary</h3>
          <div class="form-row"><label>Period</label><select id="gf-summary-year"></select> <span>or</span> <input type="date" id="gf-summary-from"> to <input type="date" id="gf-summary-to"> <button type="button" id="gf-summary-apply" class="btn btn-primary">Apply</button></div>
          <div id="gf-summary-table-wrap"></div>
          <p id="gf-summary-total" class="gf-total-line"></p>
          <p class="hint">Use this total as part of your medical expenses (lines 33099/33199) when you file your personal return in Wealthsimple or other software.</p>
          <button type="button" id="gf-export-btn" class="btn btn-secondary">Export summary (CSV)</button>
          <button type="button" id="gf-export-zip-btn" class="btn btn-secondary">Download report + receipts (ZIP)</button>
          <button type="button" id="gf-print-btn" class="btn btn-secondary">Print summary</button>
        </div>
      </section>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
