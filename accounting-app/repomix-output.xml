  const GF_CURRENT_RECEIPT_KEY = 'gf_current_receipt_id';
  const GF_CURRENT_RECEIPT_NAME_KEY = 'gf_current_receipt_name';
  const GF_CURRENT_RECEIPT_DATE_KEY = 'gf_current_receipt_date';
