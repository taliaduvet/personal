<file path="styles.css">
:root {
  --bg: #f7efe7;
  --surface: #fffaf5;
  --surface-strong: #f3e4d6;
  --text: #2f241a;
  --muted: #7b6856;
  --border: #dcc9b5;
  --accent: #c26f45;
  --accent-strong: #a6542d;
  --green: #2f7d5a;
  --red: #b54a4a;
  --warn: #9c6a2c;
  --radius: 12px;
  --shadow: 0 8px 24px rgba(70, 46, 26, 0.09);
}

* { box-sizing: border-box; }
body { margin: 0; background: radial-gradient(circle at top, #fff8f1 0%, var(--bg) 55%); color: var(--text); font-family: Inter, "SF Pro Text", system-ui, sans-serif; min-height: 100vh; line-height: 1.45; }
input, select, button, textarea { font: inherit; color: inherit; }
button { cursor: pointer; }
h3 { margin: 0 0 0.9rem 0; font-size: 1.05rem; }

.app-wrap { max-width: 1200px; margin: 0 auto; padding: 1.25rem; }
.main-app { display: none; }
.main-app.visible { display: block; }
.panel { display: none; }
.panel.visible { display: block; }
.hidden { display: none !important; }

input, select, textarea {
  border: 1px solid var(--border);
  background: #fff;
  border-radius: 10px;
  padding: 0.58rem 0.7rem;
}
input:focus, select:focus, textarea:focus, button:focus {
  outline: 2px solid rgba(194, 111, 69, 0.35);
  outline-offset: 1px;
}

.btn, .btn-primary, .btn-secondary, .btn-danger {
  border-radius: 10px;
  border: 1px solid transparent;
  padding: 0.54rem 0.9rem;
  font-weight: 600;
}
.btn-primary { background: var(--accent); color: #fff; }
.btn-primary:hover { background: var(--accent-strong); }
.btn-secondary { background: var(--surface-strong); border-color: var(--border); color: var(--text); }
.btn-secondary:hover { background: #ead8c7; }
.btn-danger { background: #fff0f0; color: var(--red); border-color: #e5b2b2; }
.btn-sm { padding: 0.3rem 0.5rem; font-size: 0.84rem; }

.auth-screen { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 80vh; padding: 2rem; }
.auth-screen h1 { margin: 0 0 0.3rem 0; }
.auth-screen p { color: var(--muted); margin: 0 0 1.2rem 0; }
.auth-form { width: min(360px, 92vw); background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 1rem; box-shadow: var(--shadow); }
.auth-form input, .auth-form button { width: 100%; }
.auth-form input { margin-bottom: 0.65rem; }
.auth-form .error { color: var(--red); margin-top: 0.25rem; }
.auth-form .toggle { margin-top: 0.8rem; text-align: center; }
.auth-form .toggle button { border: none; background: transparent; color: var(--accent-strong); text-decoration: underline; padding: 0; }

header.main-header { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; align-items: center; justify-content: space-between; padding: 0.35rem 0 1rem 0; border-bottom: 1px solid var(--border); margin-bottom: 1rem; }
header.main-header h1 { margin: 0; font-size: 1.38rem; }
header.main-header .user { color: var(--muted); }
header.main-header button { border: 1px solid var(--border); background: var(--surface); border-radius: 8px; padding: 0.35rem 0.6rem; }

nav.tabs { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-bottom: 1.15rem; }
nav.tabs button {
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--muted);
  border-radius: 999px;
  padding: 0.42rem 0.75rem;
  font-weight: 600;
}
nav.tabs button.active { background: var(--accent); color: #fff; border-color: var(--accent); }
nav.tabs button:hover:not(.active) { background: #f2e6db; color: var(--text); }

.period-controls, .report-controls, .budget-controls {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  gap: 0.65rem;
  margin-bottom: 0.95rem;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 0.8rem;
}
.period-controls label, .report-controls label, .budget-controls label { color: var(--muted); font-size: 0.9rem; }

.dash-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 0.75rem; margin-bottom: 1rem; }
.dash-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); padding: 0.85rem; }
.dash-card .label { color: var(--muted); font-size: 0.82rem; }
.dash-card .value { font-size: 1.42rem; font-weight: 700; }
.dash-card .dash-period { color: var(--muted); font-size: 0.78rem; margin-top: 0.2rem; }
.dash-card.income .value { color: var(--green); }
.dash-card.expense .value { color: var(--red); }

.entry-list { display: grid; gap: 0.55rem; }
.entry-row {
  display: grid;
  grid-template-columns: minmax(90px, 130px) 1fr auto;
  align-items: center;
  gap: 0.55rem;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 0.7rem 0.8rem;
}
.entry-row .date { color: var(--muted); font-size: 0.86rem; }
.entry-row .meta { color: var(--muted); font-size: 0.86rem; }
.entry-row .amount { font-weight: 700; white-space: nowrap; }
.entry-row.income .amount { color: var(--green); }
.entry-row.expense .amount { color: var(--red); }
.entry-row .actions { display: flex; flex-wrap: wrap; gap: 0.35rem; justify-content: flex-end; }
.entry-row .actions button { border: 1px solid var(--border); background: #fff; border-radius: 8px; padding: 0.24rem 0.45rem; }
.entry-row .actions button:hover { background: var(--surface-strong); }

.form-wrap, .bank-import, .report-summary, #budget-planned-form-wrap, .gf-instructions {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}
.form-wrap, .bank-import, .report-summary, #budget-planned-form-wrap { padding: 0.9rem; }
.form-row { margin-bottom: 0.85rem; }
.form-row label { display: block; color: var(--muted); font-size: 0.9rem; margin-bottom: 0.26rem; }
.form-actions { display: flex; gap: 0.45rem; flex-wrap: wrap; margin-top: 0.8rem; }

.panel-summary { margin-bottom: 0.6rem; }
.panel-summary-inner .muted { color: var(--muted); margin-left: 0.35rem; }
.panel-breakdown-table, .report-by-category table, .report-table, #budget-category-table table, .budget-planned-table {
  width: 100%;
  border-collapse: collapse;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
}
.panel-breakdown-table th, .panel-breakdown-table td,
.report-by-category th, .report-by-category td,
.report-table th, .report-table td,
#budget-category-table th, #budget-category-table td,
.budget-planned-table th, .budget-planned-table td {
  text-align: left;
  padding: 0.52rem 0.68rem;
  border-bottom: 1px solid var(--border);
}
.panel-breakdown-table th, .report-by-category th, .report-table th, #budget-category-table th, .budget-planned-table th { color: var(--muted); font-size: 0.85rem; background: #fff6ee; }
.panel-breakdown-table tr:last-child td,
.report-by-category tr:last-child td,
