# Studio OS — local environment
# Copy this file to `.env.local` and fill in the values. Never commit `.env.local`.

# --- Supabase (M0: auth) ---------------------------------------------------
# Project URL + anon key from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Coming in later milestones (leave blank for now) ----------------------
# Supabase service role (server-only, used by the Sheets proxy in M1+)
# SUPABASE_SERVICE_ROLE_KEY=

# Stripe (billing, M4)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google OAuth client ID (Web) — for Calendar connect in week planning
# Create in Google Cloud Console → Credentials → OAuth 2.0 Client IDs
# Authorized JavaScript origins: http://localhost:3000 (and your production URL)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Picker API key (Google Cloud Console → APIs → Picker API → Credentials)
# Enables "Choose folder in Google Drive" on Projects. Paste-link still works without it.
# NEXT_PUBLIC_GOOGLE_API_KEY=
