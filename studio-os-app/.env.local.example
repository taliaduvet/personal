# Studio OS — local environment
# Copy this file to `.env.local` and fill in the values. Never commit `.env.local`.

# --- Supabase (M0: auth) ---------------------------------------------------
# Project URL + anon key from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local pre-deploy only — bypasses login redirect. Remove before production.
SKIP_AUTH=true

# --- Google (Calendar, Drive picker, Contacts, Sheets) ---------------------
# Same Google Cloud project for all of these.

# OAuth 2.0 Client ID (Web application)
# Console → Credentials → Create OAuth client ID → Web application
# Authorized JavaScript origins: http://localhost:3000
# Authorized redirect URIs (must match exactly — no trailing slash):
#   http://localhost:3000/api/google-oauth-callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# OAuth client secret (same Web application credential — server-side only, never NEXT_PUBLIC)
# Console → Credentials → your OAuth 2.0 Client ID → Client secret
GOOGLE_CLIENT_SECRET=

# API key (Browser key) — separate from Client ID; required for Drive folder/doc picker
# Console → Credentials → Create credentials → API key
# Restrict key → HTTP referrers → http://localhost:3000/*
# Enable APIs: Google Picker API, Google Drive API, People API, Calendar API, Sheets API
NEXT_PUBLIC_GOOGLE_API_KEY=

